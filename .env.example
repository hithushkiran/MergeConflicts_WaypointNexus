# Safe local-development values only. Do not use these outside local development.
APP_ENV=development
TZ=Asia/Colombo
DEV_SEED_PASSWORD=waypoint-local-demo
AUTH_SESSION_TTL_HOURS=12
ORDER_CUTOFF_LOCAL_TIME=16:00

POSTGRES_DB=waypoint_nexus
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint_local_password
POSTGRES_PORT=5432

# Within Docker Compose, the API reaches PostgreSQL at the `db` service hostname.
DATABASE_URL=postgresql+psycopg://waypoint:waypoint_local_password@db:5432/waypoint_nexus
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

VITE_API_URL=http://localhost:8000
WEB_PORT=5173
